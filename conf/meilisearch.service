[Unit]
Description=Meilisearch search engine for __APP__
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
# Meilisearch creates its `dumps/` directory relative to the process CWD.
# Without a writable CWD (default is /) it fails with "Permission denied (os error 13)".
WorkingDirectory=__DATA_DIR__
ExecStart=/usr/bin/meilisearch --http-addr 127.0.0.1:7700 --master-key __MEILI_MASTER_KEY__ --db-path __DATA_DIR__/meilisearch --no-analytics
Restart=on-failure

# Basic hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
# NOTE: ProtectHome is deliberately NOT set. YunoHost's data_dir lives under
# /home/yunohost.app/<app>; ProtectHome=yes makes /home inaccessible, which
# breaks Meilisearch's --db-path with "Permission denied (os error 13)" even
# though ReadWritePaths grants the subtree (the path is hidden, not read-only).
# Allow Meili to write its index under the read-only /var (ProtectSystem=full)
ReadWritePaths=__DATA_DIR__/meilisearch

[Install]
WantedBy=multi-user.target
