# LibreChat environment file — template for YunoHost (ynh_config_add).
# Tokens of the form DOUBLE-UNDERSCORE NAME DOUBLE-UNDERSCORE are replaced
# during install; each token resolves from the matching lowercase bash variable.

# Server
# Bind IPv4 explicitly: nginx proxies to http://127.0.0.1:__PORT__. With
# HOST=localhost, Node resolves localhost to ::1 (IPv6) first on Debian
# (/etc/hosts lists ::1 before 127.0.0.1), so nginx gets "connection refused"
# and returns 502. 127.0.0.1 makes the bind and the proxy target match.
HOST=127.0.0.1
PORT=__PORT__
DOMAIN_CLIENT=https://__DOMAIN__
DOMAIN_SERVER=https://__DOMAIN__
TRUST_PROXY=1

# MongoDB
MONGO_URI=mongodb://__DB_USER__:__DB_PWD__@127.0.0.1:27017/__DB_NAME__

# Meilisearch (disabled by default — user must set SEARCH=true and MEILI_MASTER_KEY)
SEARCH=false
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=__MEILI_MASTER_KEY__
MEILI_NO_ANALYTICS=true

# JWT Secrets (generated during install)
JWT_SECRET=__JWT_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__

# Admin panel session secret
ADMIN_PANEL_SESSION_SECRET=__ADMIN_PANEL_SECRET__

# Registration (start closed, admin creates users)
ALLOW_REGISTRATION=false

# Logging
DEBUG_LOGGING=true
LOG_TO_FILE=true

# Node
NODE_ENV=production
